# Aria environment configuration
ARIA_ENV=dev
ARIA_LOG_LEVEL=info

# LLM provider: mock | echo | ollama | openrouter
ARIA_LLM_PROVIDER=mock

# Ollama (Phase 1) — used when ARIA_LLM_PROVIDER=ollama
ARIA_OLLAMA_URL=http://127.0.0.1:11434
ARIA_OLLAMA_MODEL=qwen3.5:latest
# ARIA_OLLAMA_TEMPERATURE=0.4
# ARIA_OLLAMA_MAX_TOKENS=1024
# ARIA_OLLAMA_TIMEOUT_MS=120000

# OpenRouter (optional online) — used when ARIA_LLM_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys — never commit real keys
# ARIA_OPENROUTER_API_KEY=
# ARIA_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ARIA_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# ARIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ARIA_OPENROUTER_TEMPERATURE=0.4
# ARIA_OPENROUTER_MAX_TOKENS=1024
# ARIA_OPENROUTER_TIMEOUT_MS=120000
# ARIA_OPENROUTER_HTTP_REFERER=https://github.com/your-org/Aria
# ARIA_OPENROUTER_APP_TITLE=Aria

# Personality / system prompt engine
ARIA_NAME=Aria
# ARIA_PERSONALITY_TONE=warm, concise, and practical
# ARIA_PERSONALITY_TRAITS=helpful,bilingual,safety-aware,home-focused
# ARIA_PERSONALITY_INSTRUCTIONS=
# ARIA_SYSTEM_PROMPT=

# Tool calling
ARIA_TOOLS_ENABLED=true
ARIA_TOOLS_MAX_ROUNDS=3

# Optional web look-up tools (local-first: off by default)
# ARIA_WEB_ENABLED=true
# ARIA_WEB_SEARCH_PROVIDER=mock   # mock | duckduckgo
# ARIA_SEARCH_PROVIDERS=duckduckgo,wikipedia  # optional; stubs: searxng,brave,bing,github
# ARIA_WEB_TIMEOUT_MS=15000
# ARIA_WEB_MAX_RESULTS=5
# ARIA_WEB_MAX_PAGE_CHARS=8000

# Message bus: inprocess | nats
ARIA_BUS=inprocess
# ARIA_NATS_URL=

# Phase 4 — Vision
# Gemini free-tier CV (default): https://ai.google.dev/gemini-api/docs/image-understanding
# ARIA_GEMINI_API_KEY=
# ARIA_GEMINI_VISION_MODEL=gemini-2.0-flash
# ARIA_VISION_PROVIDER=gemini   # mock | sidecar | gemini
# ARIA_VISION_SIDECAR_URL=http://127.0.0.1:8766
# Webcam capture still uses local OpenCV sidecar (detection is Gemini)
# ARIA_VISION_SIDECAR_MODE=real
# ARIA_VISION_CAMERA_DEVICE=0
# ARIA_VISION_CAMERA_ENABLED=true
# ARIA_VISION_ANALYZE_INTERVAL_MS=1000
# ARIA_VISION_TRACK_ENABLED=true
# ARIA_VISION_VLM_ENABLED=true
# ARIA_VISION_ENABLED=true
# Face recognition is PRIVATE / opt-in — never always-on
# ARIA_VISION_FACE_ENABLED=false
# Legacy local YOLO: ARIA_VISION_PROVIDER=sidecar + ARIA_VISION_DETECT_MODEL=yolo26n
