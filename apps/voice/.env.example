# Local inference sidecar
ARIA_VOICE_SIDECAR_URL=http://127.0.0.1:8765

# Audio: 16 kHz mono signed 16-bit little-endian PCM
ARIA_AUDIO_SAMPLE_RATE=16000
ARIA_AUDIO_CHUNK_MS=96
# Windows dshow requires the exact microphone name from:
#   ffmpeg -list_devices true -f dshow -i dummy
# Example: Microphone Array (Realtek(R) Audio)
ARIA_MICROPHONE_DEVICE=default
ARIA_FFMPEG_EXECUTABLE=ffmpeg
ARIA_FFPLAY_EXECUTABLE=ffplay
# ffmpeg | browser | ffmpeg+browser (web UI: push-to-talk + optional system mic)
ARIA_AUDIO_SOURCE=ffmpeg+browser
ARIA_GATEWAY_HOST=127.0.0.1
ARIA_GATEWAY_PORT=8787

# Silero VAD
ARIA_VAD_THRESHOLD=0.5
ARIA_VAD_MIN_SILENCE_MS=500
ARIA_VAD_PRE_SPEECH_MS=288
ARIA_MAX_UTTERANCE_MS=30000

# Faster-Whisper
# Prefer cuda after installing CUDA PyTorch / CUDA ctranslate2.
# If torch.cuda.is_available() is False, use cpu + int8 until CUDA wheels are installed.
ARIA_STT_MODEL=medium
ARIA_STT_DEVICE=auto
ARIA_STT_COMPUTE_TYPE=int8
ARIA_STT_BEAM_SIZE=5

# Piper (use full path on Windows if `piper` is not on PATH)
# Example: D:\Aria\sidecars\voice\.venv\Scripts\piper.exe
# Prefer absolute model paths so the sidecar finds them regardless of cwd.
ARIA_PIPER_EXECUTABLE=piper
ARIA_PIPER_EN_MODEL=models/piper/en_US-lessac-medium.onnx
ARIA_PIPER_FA_MODEL=models/piper/fa_IR-gyro-medium.onnx

# Phase 1 brain
ARIA_LLM_PROVIDER=ollama
ARIA_OLLAMA_MODEL=qwen3.5:latest
ARIA_LOG_LEVEL=info

# Optional web look-up tools (off by default)
# ARIA_WEB_ENABLED=true
# ARIA_WEB_SEARCH_PROVIDER=mock   # mock | duckduckgo
