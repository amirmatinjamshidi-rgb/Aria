{
  "name": "@aria/brain",
  "version": "0.1.0",
  "description": "Aria cognitive brain — LLM orchestration, personality, tool calling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "chat": "tsx src/cli/chat.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx src/cli/run-eval.ts",
    "bench": "tsx src/cli/run-bench.ts"
  },
  "dependencies": {
    "@aria/contracts": "*",
    "@aria/core": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "ora": "^9.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
