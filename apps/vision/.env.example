# Gemini free-tier CV (image understanding) — get a key at https://aistudio.google.com/apikey
ARIA_GEMINI_API_KEY=
ARIA_GEMINI_VISION_MODEL=gemini-2.0-flash
# mock | sidecar (local YOLO) | gemini (cloud CV)
ARIA_VISION_PROVIDER=gemini
# Prefer ≥4500 on Gemini free tier to stay under ~13 RPM
ARIA_VISION_ANALYZE_INTERVAL_MS=4500
ARIA_GEMINI_MIN_INTERVAL_MS=4500
# Skip Gemini while the OpenCV sidecar reports an unchanged frame
ARIA_VISION_FRAME_DIFF_ENABLED=true
ARIA_VISION_FRAME_DIFF_THRESHOLD=12
ARIA_VISION_SIDECAR_URL=http://127.0.0.1:8766
# Capture-only sidecar still needed for the webcam (OpenCV)
ARIA_VISION_SIDECAR_MODE=real
ARIA_VISION_CAMERA_DEVICE=0
ARIA_VISION_CAMERA_ENABLED=true
ARIA_VISION_VLM_ENABLED=true
# Web lab stays camera-idle until Start video; this only hides that button when false
ARIA_VISION_ENABLED=true
ARIA_VISION_TRACK_ENABLED=true
ARIA_VISION_CONFIDENCE=0.25
