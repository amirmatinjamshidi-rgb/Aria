{
  "name": "aria",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Aria — modular, local-first humanoid robot software platform",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "sdk"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@aria/brain",
    "chat": "npm run chat -w @aria/brain",
    "voice": "npm run dev -w @aria/voice",
    "voice:web": "npm run web -w @aria/voice",
    "voice:sidecar": "node scripts/run-voice-sidecar.mjs",
    "vision": "npm run dev -w @aria/vision",
    "vision:sidecar": "node scripts/run-vision-sidecar.mjs",
    "dashboard": "npm run dev -w @aria/dashboard",
    "desktop:dev": "npm run dev -w @aria/desktop",
    "desktop:build": "npm run build -w @aria/desktop",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
